.hero-sub { font-size: 17px; color: rgba(255,255,255,0.7); max-width: 600px; }

.article-content { max-width: 780px; margin: 0 auto; }
.article-lead { font-size: 18px; line-height: 1.8; color: var(--brand-text); margin-bottom: 40px; border-left: 3px solid var(--brand-accent); padding-left: 20px; }

