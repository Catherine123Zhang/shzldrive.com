---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { t } from '../../../i18n/translations';
import type { Locale } from '../../../i18n/translations';
import { productsPage } from '../../../i18n/content/products';

const locale: Locale = 'ar';
const lp = '/ar';
const p = productsPage[locale];
const alternates = [
  { locale: 'en', path: '/products/' },
  { locale: 'es', path: '/es/products/' },
  { locale: 'pt', path: '/pt/products/' },
  { locale: 'fr', path: '/fr/products/' },
  { locale: 'ar', path: '/ar/products/' },
  { locale: 'ru', path: '/ru/products/' },
  { locale: 'vi', path: '/vi/products/' },
  { locale: 'id', path: '/id/products/' },
];

const categorySlugs = [
  'l-type-geared-motors',
  'r-type-geared-motors',
  'cylindrical-bldc-motors',
  'high-power-motors',
  'planetary-gear-motors',
  'controllers-drivers',
  'accessories',
] as const;

const categoryImages: Record<string, string> = {
  'l-type-geared-motors': '/assets/images/products/bldc-l-type-gear-motor.jpg',
  'r-type-geared-motors': '/assets/images/products/bl-104-1.jpg',
  'cylindrical-bldc-motors': '/assets/images/products/bl-90-1.jpg',
  'high-power-motors': '/assets/images/products/bldc-high-power-motor.jpg',
  'planetary-gear-motors': '/assets/images/products/bldc-large-flange-motor.jpg',
  'controllers-drivers': '/assets/images/products/bldc-controller-48v.jpg',
  'accessories': '/assets/images/products/app-control-system-pcb.jpg',
};

const categorySpecs: Record<string, string> = {
  'l-type-geared-motors': '60\u2013120mm flange, 30\u20132000W',
  'r-type-geared-motors': '90\u2013104mm flange, 120\u2013750W',
  'cylindrical-bldc-motors': '60\u2013130mm diameter, 30\u20132000W',
  'high-power-motors': '750\u20133000W, 48\u201372V',
  'planetary-gear-motors': '42\u201390mm, 15\u2013750W',
  'controllers-drivers': '12\u201372V, up to 80A',
  'accessories': 'Brakes, Encoders, Connectors',
};
---

<BaseLayout
  title={p.title}
  description={p.description}
  locale="ar"
  alternates={alternates}
>

<section class="hero-inner">
  <div class="container">
    <p class="breadcrumb"><a href={`${lp}/`}>{p.breadcrumbHome}</a> &rarr; {p.breadcrumbProducts}</p>
    <h1>{p.h1}</h1>
    <p class="hero-sub">{p.heroSub}</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="product-grid">
      {categorySlugs.map((slug) => {
        const cat = p.categories[slug];
        return (
          <a href={`${lp}/products/${slug}/`} class="product-card">
            <div class="product-card-img">
              <img src={categoryImages[slug]} alt={cat.name} loading="lazy" />
            </div>
            <div class="product-card-body">
              <div class="product-card-header">
                <h2>{cat.name}</h2>
                <span class="product-specs">{categorySpecs[slug]}</span>
              </div>
              <p class="product-desc">{cat.description}</p>
              <ul class="product-features">
                {cat.features.map((f) => <li>{f}</li>)}
              </ul>
              <div class="product-card-actions">
                <span class="product-cta">{p.viewDetails} &rarr;</span>
                <span class="product-quote-cta">{p.getQuote}</span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<section class="section power-range-section">
  <div class="container">
    <h2 class="section-title">{p.powerRangeTitle}</h2>
    <p class="section-desc">{p.powerRangeDesc}</p>
    <div class="range-bar">
      <div class="range-segment range-light">
        <span class="range-label">15–120W</span>
        <span class="range-app">{p.rangeLightApp}</span>
      </div>
      <div class="range-segment range-mid">
        <span class="range-label">120–750W</span>
        <span class="range-app">{p.rangeMidApp}</span>
      </div>
      <div class="range-segment range-heavy">
        <span class="range-label">750–3000W</span>
        <span class="range-app">{p.rangeHeavyApp}</span>
      </div>
    </div>
  </div>
</section>

<section class="section cta-section">
  <div class="container cta-inner">
    <h2>{p.ctaTitle}</h2>
    <p>{p.ctaDesc}</p>
    <div class="cta-multi">
      <a href={`${lp}/drive-selection/`} class="btn btn-primary btn-lg">{p.ctaDriveRec} &rarr;</a>
      <a href="https://wa.me/8618268661068?text=Hi%2C%20I%20need%20help%20choosing%20a%20BLDC%20motor." class="btn btn-wa-lg" target="_blank" rel="noopener">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        {p.ctaWhatsapp}
      </a>
    </div>
  </div>
</section>

</BaseLayout>

<style>
.hero-inner { background: var(--brand-dark); color: white; padding: 48px 0 56px; }
.breadcrumb { font-size: 13px; color: rgba(255,255,255,0.5); margin-bottom: 16px; }
.breadcrumb a { color: rgba(255,255,255,0.5); text-decoration: none; }
.hero-inner h1 { font-size: 36px; margin-bottom: 16px; }
.hero-sub { font-size: 17px; color: rgba(255,255,255,0.7); max-width: 600px; }
.product-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.product-card { background: var(--brand-surface); border: 1px solid var(--brand-border); border-radius: 12px; overflow: hidden; display: flex; flex-direction: column; transition: all 0.2s; text-decoration: none; color: var(--brand-text); }
.product-card-img { height: 220px; overflow: hidden; background: #f5f5f5; display: flex; align-items: center; justify-content: center; padding: 16px; }
.product-card-img img { max-width: 100%; max-height: 100%; object-fit: contain; }
.product-card-body { padding: 24px; display: flex; flex-direction: column; flex: 1; }
.product-card:hover { border-color: var(--brand-accent); transform: translateY(-2px); box-shadow: 0 8px 24px rgba(0,0,0,0.08); }
.product-card-header { margin-bottom: 12px; }
.product-card h2 { font-size: 20px; margin-bottom: 4px; }
.product-specs { font-size: 13px; color: var(--brand-accent); font-weight: 600; }
.product-desc { font-size: 14px; color: var(--brand-text-light); line-height: 1.6; margin-bottom: 16px; }
.product-features { list-style: none; margin-bottom: 20px; flex: 1; }
.product-features li { font-size: 13px; padding: 3px 0; color: var(--brand-text); }
.product-features li::before { content: '\2192 '; color: var(--brand-accent); font-weight: 600; }
.product-card-actions { display: flex; justify-content: space-between; align-items: center; }
.product-cta { color: var(--brand-accent); font-weight: 600; font-size: 14px; }
.product-quote-cta { font-size: 12px; font-weight: 600; color: white; background: var(--brand-accent); padding: 6px 14px; border-radius: 4px; }

/* Power Range Bar */
.power-range-section { background: var(--brand-surface); }
.range-bar { display: grid; grid-template-columns: 1fr 1.2fr 1fr; gap: 4px; border-radius: 10px; overflow: hidden; }
.range-segment { padding: 24px 20px; text-align: center; }
.range-light { background: #e0f2fe; }
.range-mid { background: #bbf7d0; }
.range-heavy { background: #fef3c7; }
.range-label { display: block; font-size: 20px; font-weight: 800; color: var(--brand-primary); margin-bottom: 4px; }
.range-app { font-size: 13px; color: var(--brand-text-light); }

.section-title { font-size: 32px; text-align: center; margin-bottom: 12px; }
.section-desc { text-align: center; color: var(--brand-text-light); margin-bottom: 48px; max-width: 560px; margin-left: auto; margin-right: auto; }
.cta-section { background: var(--brand-primary); color: white; text-align: center; }
.cta-inner h2 { font-size: 32px; margin-bottom: 12px; }
.cta-inner p { color: rgba(255,255,255,0.7); margin-bottom: 32px; font-size: 17px; }
.cta-multi { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
.btn-lg { padding: 18px 36px; font-size: 16px; }
.btn-wa-lg {
  background: #25D366; color: white; display: inline-flex; align-items: center; gap: 8px;
  padding: 18px 32px; border-radius: 6px; font-weight: 600; font-size: 16px; text-decoration: none;
}
.btn-wa-lg:hover { background: #1ebe57; }

@media (max-width: 768px) {
  .product-grid { grid-template-columns: 1fr; }
  .range-bar { grid-template-columns: 1fr; }
}
</style>
