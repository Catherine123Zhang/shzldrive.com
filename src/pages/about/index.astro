---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About 盛合智联 Drive — Ningbo BLDC Motor Manufacturer"
  description="Ningbo Shenghe Zhilian Motor Co., Ltd. — 15+ years manufacturing BLDC drive systems for heavy-duty mobile equipment. ISO 9001, CE/LVD, RoHS certified. 50+ employees."
  canonical="https://www.nbshzl-motor.com/about/"
>

<section class="hero-inner">
  <div class="container">
    <p class="breadcrumb"><a href="/">Home</a> &rarr; About</p>
    <h1>About 盛合智联 Drive</h1>
    <p class="hero-sub">
      The drive behind China's leading powered machinery movers.
    </p>
  </div>
</section>

<!-- Company Overview -->
<section class="section">
  <div class="container about-intro">
    <div class="about-text">
      <h2>Ningbo Shenghe Zhilian Motor Co., Ltd.</h2>
      <p class="about-lead">
        盛合智联 Drive is a Ningbo-based manufacturer specializing in complete BLDC (brushless DC) drive
        systems — motor, gearbox, brake, controller and encoder — for heavy-duty mobile equipment and
        industrial automation.
      </p>
      <p>
        With over 15 years of experience and 50+ dedicated employees, we design and manufacture drive
        systems that power battery-operated machinery movers, transport trolleys, heavy-duty AGVs,
        PV cleaning robots and a wide range of industrial equipment.
      </p>
      <p>
        Our drive systems are widely adopted by leading powered machinery mover manufacturers in China.
        Through our OEM partners, 盛合智联 Drive motors are already operating in factories, warehouses
        and solar farms across 20+ countries worldwide.
      </p>
    </div>
    <div class="about-stats">
      <div class="stat-card">
        <span class="stat-num">15+</span>
        <span class="stat-label">Years Experience</span>
      </div>
      <div class="stat-card">
        <span class="stat-num">50+</span>
        <span class="stat-label">Employees</span>
      </div>
      <div class="stat-card">
        <span class="stat-num">20+</span>
        <span class="stat-label">Export Countries</span>
      </div>
      <div class="stat-card">
        <span class="stat-num">3kW</span>
        <span class="stat-label">Max Drive Power</span>
      </div>
    </div>
  </div>
</section>

<!-- Factory Video -->
<section class="section factory-video-section">
  <div class="container">
    <h2 class="section-title">See Our Factory in Action</h2>
    <div class="video-wrap">
      <video controls preload="metadata" poster="/assets/images/factory/workshop-floor.jpg" class="factory-video">
        <source src="/assets/video/factory-hero-loop.mp4" type="video/mp4" />
        Your browser does not support the video tag.
      </video>
    </div>
  </div>
</section>

<!-- Factory Gallery -->
<section class="section factory-gallery">
  <div class="container">
    <h2 class="section-title">Our Factory</h2>
    <div class="gallery-grid">
      <img src="/assets/images/factory/assembly-line.jpg" alt="Motor assembly line" loading="lazy" />
      <img src="/assets/images/factory/cnc-row.jpg" alt="CNC machining center" loading="lazy" />
      <img src="/assets/images/factory/rd-test-bench.jpg" alt="R&D test bench" loading="lazy" />
      <img src="/assets/images/factory/rotors-finished.jpg" alt="Finished motor rotors" loading="lazy" />
      <img src="/assets/images/factory/controller-pcb.jpg" alt="Controller PCB production" loading="lazy" />
      <img src="/assets/images/factory/warehouse.jpg" alt="Finished goods warehouse" loading="lazy" />
    </div>
  </div>
</section>

<!-- Certifications -->
<section class="section cert-section">
  <div class="container">
    <h2 class="section-title">Certifications & Quality</h2>
    <p class="section-desc">Every motor and drive system is manufactured under certified quality management and meets international safety standards.</p>
    <div class="grid-3">
      <div class="cert-card">
        <div class="cert-icon">ISO</div>
        <h3>ISO 9001</h3>
        <p>Quality management system certified. Consistent manufacturing processes from raw materials to finished drive assemblies.</p>
      </div>
      <div class="cert-card">
        <div class="cert-icon">CE</div>
        <h3>CE / LVD</h3>
        <p>Low Voltage Directive compliance for the European market. All motors and controllers meet EU safety requirements.</p>
      </div>
      <div class="cert-card">
        <div class="cert-icon">RoHS</div>
        <h3>RoHS Compliant</h3>
        <p>Restriction of Hazardous Substances compliance. Environmentally responsible manufacturing throughout our product range.</p>
      </div>
    </div>
  </div>
</section>

<!-- Capabilities -->
<section class="section">
  <div class="container">
    <h2 class="section-title">Manufacturing Capabilities</h2>
    <p class="section-desc">Complete BLDC drive systems — designed, manufactured and tested under one roof.</p>
    <div class="capability-grid">
      <div class="capability-item">
        <h3>BLDC Motors</h3>
        <p>Brushless DC motors from 15W to 3,000W, 12–220V. Cylindrical, planetary and geared configurations in 42–130mm frame sizes.</p>
      </div>
      <div class="capability-item">
        <h3>Gearboxes</h3>
        <p>Worm gear, helical gear and planetary gear reducers. L-type and R-type integrated gearbox assemblies with ratios from 5:1 to 200:1.</p>
      </div>
      <div class="capability-item">
        <h3>Controllers & Drivers</h3>
        <p>FOC and trapezoidal BLDC motor controllers. Standalone and integrated options with CAN bus, RS485 and analog interfaces.</p>
      </div>
      <div class="capability-item">
        <h3>Electromagnetic Brakes</h3>
        <p>Spring-applied, power-off fail-safe brakes integrated into motor assemblies. Critical for slope-holding in transport equipment.</p>
      </div>
      <div class="capability-item">
        <h3>Encoders & Feedback</h3>
        <p>Incremental encoders for speed and position feedback. Essential for AGV navigation and precision positioning applications.</p>
      </div>
      <div class="capability-item">
        <h3>Custom Integration</h3>
        <p>Custom shaft, mounting, winding and connector configurations. We adapt our standard platforms to your mechanical and electrical interface.</p>
      </div>
    </div>
  </div>
</section>

<!-- Engineering Support -->
<section class="section eng-support-section">
  <div class="container">
    <h2 class="section-title">Engineering Support</h2>
    <p class="section-desc">We don't just sell motors. We help you select, test and integrate the right drive system for your equipment.</p>
    <div class="grid-3">
      <div class="support-card">
        <h3>Rapid Drive Selection</h3>
        <p>Share your payload, speed, voltage and wheel diameter. Our engineers calculate the required torque and recommend a matched drive configuration — typically within 24 hours.</p>
      </div>
      <div class="support-card">
        <h3>Prototype Drive Kits</h3>
        <p>Receive a complete motor + gearbox + controller + brake assembly, pre-wired and documented, ready for bench testing in your equipment.</p>
      </div>
      <div class="support-card">
        <h3>Ongoing Technical Support</h3>
        <p>From initial selection through volume production. Wiring guidance, controller tuning, mechanical integration review and field troubleshooting support.</p>
      </div>
    </div>
    <div class="support-cta">
      <a href="/drive-selection/" class="btn btn-primary">Get a Drive Recommendation &rarr;</a>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="section cta-section">
  <div class="container cta-inner">
    <h2>Work With Us</h2>
    <p>Whether you're designing new equipment or looking for a reliable motor supplier, we'd like to hear about your application.</p>
    <div class="cta-actions">
      <a href="/drive-selection/" class="btn btn-primary btn-lg">Discuss Your Application &rarr;</a>
      <a href="https://wa.me/8618268661068?text=Hi%2C%20I%27d%20like%20to%20discuss%20a%20motor%20project." class="btn btn-wa-lg" target="_blank" rel="noopener">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        WhatsApp: +86 182 6866 1068
      </a>
      <a href="/contact/" class="btn btn-outline">Contact Us</a>
    </div>
  </div>
</section>

</BaseLayout>

<style>
.hero-inner { background: linear-gradient(135deg, rgba(15,23,42,0.92) 0%, rgba(15,23,42,0.85) 100%), url('/assets/images/factory/workshop-floor.jpg') center/cover; color: white; padding: 48px 0 56px; }
.breadcrumb { font-size: 13px; color: rgba(255,255,255,0.5); margin-bottom: 16px; }
.breadcrumb a { color: rgba(255,255,255,0.5); text-decoration: none; }
.hero-inner h1 { font-size: 36px; margin-bottom: 16px; }
.hero-sub { font-size: 17px; color: rgba(255,255,255,0.7); max-width: 600px; }

/* About Intro */
.about-intro {
  display: grid;
  grid-template-columns: 1fr 320px;
  gap: 48px;
  align-items: start;
}
.about-text h2 { font-size: 24px; margin-bottom: 20px; }
.about-lead { font-size: 17px; line-height: 1.7; margin-bottom: 16px; color: var(--brand-text); }
.about-text p { font-size: 15px; line-height: 1.7; color: var(--brand-text-light); margin-bottom: 12px; }

.about-stats {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}
.stat-card {
  background: var(--brand-surface);
  border: 1px solid var(--brand-border);
  border-radius: 10px;
  padding: 24px 16px;
  text-align: center;
}
.stat-num {
  display: block;
  font-size: 32px;
  font-weight: 800;
  color: var(--brand-primary);
  margin-bottom: 4px;
}
.stat-label {
  font-size: 12px;
  color: var(--brand-text-light);
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* Certifications */
.cert-section { background: var(--brand-surface); }
.cert-card {
  background: white;
  border: 1px solid var(--brand-border);
  border-radius: 12px;
  padding: 32px;
  text-align: center;
}
.cert-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 56px;
  height: 56px;
  background: var(--brand-primary);
  color: white;
  border-radius: 50%;
  font-size: 14px;
  font-weight: 800;
  margin-bottom: 16px;
}
.cert-card h3 { font-size: 18px; margin-bottom: 8px; }
.cert-card p { font-size: 14px; color: var(--brand-text-light); line-height: 1.6; }

/* Capabilities */
.capability-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
.capability-item {
  background: var(--brand-surface);
  border: 1px solid var(--brand-border);
  border-radius: 10px;
  padding: 28px;
}
.capability-item h3 { font-size: 16px; margin-bottom: 8px; }
.capability-item p { font-size: 14px; color: var(--brand-text-light); line-height: 1.6; }

/* Engineering Support */
.eng-support-section { background: var(--brand-surface); }
.support-card {
  background: white;
  border: 1px solid var(--brand-border);
  border-radius: 12px;
  padding: 32px;
}
.support-card h3 { font-size: 18px; margin-bottom: 8px; }
.support-card p { font-size: 14px; color: var(--brand-text-light); line-height: 1.6; }
.support-cta { text-align: center; margin-top: 40px; }

/* Section utilities */
.section-title { font-size: 32px; text-align: center; margin-bottom: 12px; }
.section-desc { text-align: center; color: var(--brand-text-light); margin-bottom: 48px; max-width: 560px; margin-left: auto; margin-right: auto; }

/* CTA */
.cta-section { background: var(--brand-primary); color: white; text-align: center; }
.cta-inner h2 { font-size: 32px; margin-bottom: 12px; }
.cta-inner p { color: rgba(255,255,255,0.7); margin-bottom: 32px; font-size: 17px; }
.cta-actions { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
.btn-lg { padding: 18px 36px; font-size: 16px; }

/* Factory Video */
.factory-video-section { background: var(--brand-dark); }
.factory-video-section .section-title { color: white; }
.video-wrap { max-width: 800px; margin: 0 auto; }
.factory-video { width: 100%; border-radius: 12px; }

/* CTA QR */
.btn-wa-lg {
  background: #25D366; color: white; display: inline-flex; align-items: center; gap: 8px;
  padding: 18px 32px; border-radius: 6px; font-weight: 600; font-size: 16px; text-decoration: none;
}
.btn-wa-lg:hover { background: #1ebe57; }
.cta-qr-row { display: flex; align-items: center; justify-content: center; gap: 16px; margin-top: 24px; }
.cta-qr-img { width: 80px; height: 80px; object-fit: contain; border-radius: 6px; border: 2px solid rgba(255,255,255,0.2); }
.cta-qr-text { font-size: 13px; color: rgba(255,255,255,0.5); }

/* Factory Gallery */
.gallery-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12px;
}
.gallery-grid img {
  width: 100%;
  height: 200px;
  object-fit: cover;
  border-radius: 8px;
}

@media (max-width: 768px) {
  .about-intro { grid-template-columns: 1fr; }
  .about-stats { grid-template-columns: 1fr 1fr; }
  .capability-grid { grid-template-columns: 1fr; }
  .gallery-grid { grid-template-columns: repeat(2, 1fr); }
}
</style>
